rules_version = '2';

// Regole di sicurezza per "Game Planner"
// Si accede con Google o con email verificata. Ognuno vede solo i gruppi
// di cui fa parte; si entra in un gruppo solo con un link di invito,
// che vale per una sola persona e scade dopo 14 giorni.
// Gli admin gestiscono membri e inviti e confermano le serate;
// ogni membro può proporre serate e rispondere.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function grp(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    function isMember(gid) {
      return request.auth.uid in grp(gid).members;
    }
    function isAdmin(gid) {
      return request.auth.uid in grp(gid).admins;
    }
    // Il campo-mappa "field" cambia solo nella voce dell'utente stesso
    function onlyOwnKey(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    // Invito esistente e non scaduto (ogni invito vale per una sola persona)
    function validInvite(code) {
      return code in resource.data.get('invites', {}) && resource.data.invites[code].exp > request.time;
    }
    function ownMaps() {
      return onlyOwnKey('names') && onlyOwnKey('emails') && onlyOwnKey('prefs') && onlyOwnKey('phones');
    }

    // Profilo personale (nome, disponibilità, telefono, avatar, giochi, avvisi letti): solo il proprietario
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Chi crea il gruppo è il primo membro e il primo admin
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.admins == [request.auth.uid];

      allow update: if signedIn() && (
        // Admin: possono modificare tutto (nome, gioco, regola, membri, admin)
        request.auth.uid in resource.data.admins
        // Membro: cambia solo i propri dati (nome, email, telefono, voglia di giocare)
        || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'emails', 'prefs', 'phones'])
            && ownMaps())
        // Membro che esce dal gruppo
        || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'emails', 'prefs', 'phones'])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && ownMaps())
        // Nuovo membro che entra con un invito valido: l'invito viene consumato
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'emails', 'prefs', 'phones', 'joinCode', 'invites'])
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && validInvite(request.resource.data.joinCode)
            && !(request.resource.data.joinCode in request.resource.data.get('invites', {}))
            && request.resource.data.get('invites', {}).diff(resource.data.get('invites', {})).affectedKeys().hasOnly([request.resource.data.joinCode])
            && ownMaps())
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.admins;

      // Disponibilità dei membri: le leggono i membri, ognuno scrive solo le sue.
      // Un admin può cancellare quelle di chi rimuove dal gruppo.
      match /availability/{uid} {
        allow read: if signedIn() && isMember(gid);
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(gid);
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin(gid));
      }

      // Proposte di serata: le fa qualsiasi membro; le ritira chi le ha fatte o un admin
      match /proposals/{pid} {
        allow read: if signedIn() && isMember(gid);
        allow create: if signedIn() && isMember(gid) && request.resource.data.by == request.auth.uid;
        allow delete: if signedIn() && isMember(gid) && (resource.data.by == request.auth.uid || isAdmin(gid));
        // Un admin che revoca una serata la rimette tra le proposte a nome di chi l'aveva confermata
        allow create: if signedIn() && isAdmin(gid);
      }

      // Serate confermate: le confermano, revocano e annullano gli admin;
      // ogni membro risponde solo per sé (Ci sono / Forse / Non posso)
      match /sessions/{sid} {
        allow read: if signedIn() && isMember(gid);
        allow create, delete: if signedIn() && isAdmin(gid);
        allow update: if signedIn() && (
          isAdmin(gid)
          || (isMember(gid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps'])
              && onlyOwnKey('rsvps'))
        );
      }
    }
  }
}
